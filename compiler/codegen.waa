# ===========================================================================
#  compiler/codegen.waa -- the Wandaa code generator, written in Wandaa.
#
#  Stage 2c-iii of the bootstrap in ROADMAP.md, and a transliteration of the
#  integer-and-string core of src/codegen.cpp. It walks the AST from
#  compiler/isesengura.waa, emits instructions with compiler/x64.waa, and
#  builds the executable with compiler/pe.waa.
#
#      waa compiler/codegen.waa <dosiye.waa> <out.exe>
#
#  It compiles a SUBSET, and says so rather than pretending otherwise:
#  integers, strings, arithmetic, comparisons, `reka`, assignment, `niba`,
#  `mugihe`, `hagarika`, `komeza`, functions with parameters, `tanga` and
#  `andika`. Everything else is refused by name. compiler/verify_codegen.sh
#  requires the executables it produces to be byte-identical to wandaac's for
#  a corpus of programs inside that subset.
# ===========================================================================

injiza "isesengura.waa";
injiza "x64.waa";
injiza "pe.waa";
injiza "blob.waa";

# Argument registers, in Win64 order: RCX, RDX, R8, R9.
umurimo arg_reg(i: umubare): umubare {
  niba (i == 0) { tanga 1; }
  niba (i == 1) { tanga 2; }
  niba (i == 2) { tanga 8; }
  tanga 9;
}

# Per-function frame: parameter and local slots, and the types we could work
# out. Laid out exactly as buildFnInfo does, or the frames would not match.
ubwoko Fn {
  izina: urutonde,            # name -> byte offset (an inkoranya)
  ubwoko_bwa: urutonde,       # name -> 1 when the value is a string
  frameSize: umubare,
  epilogue: ijambo
}

ubwoko Gen {
  k: Kode,
  p: PE,
  fn: Fn,
  stackSlots: umubare,        # 8-byte temporaries currently below the frame
  labelCounter: umubare,
  amagambo: urutonde,         # string literals, in order
  loop_end: urutonde,         # enclosing loop labels, for hagarika/komeza
  loop_top: urutonde,
  fn_str: urutonde,           # function name -> 1 when it returns a string
  isohoka: urutonde,          # locals this frame may free, sorted by name
  ikosa: ijambo
}

umurimo gen_nshya(): Gen {
  tanga Gen(kode_nshya(), pe_nshya(),
            Fn(inkoranya(), inkoranya(), 0, ""),
            0, 0, urutonde(0), urutonde(0), urutonde(0), inkoranya(),
            urutonde(0), "");
}

umurimo izina_rishya(g: Gen, mbere: ijambo): ijambo {
  g.labelCounter = g.labelCounter + 1;
  tanga mbere + mu_ijambo(g.labelCounter);
}

umurimo reka_ikosa(g: Gen, ubutumwa: ijambo) {
  niba (uburebure(g.ikosa) == 0) { g.ikosa = ubutumwa; }
}

# stackSlots counts the 8-byte temporaries pushed below the frame, so a call
# can work out whether it needs 8 bytes of padding to keep RSP 16-byte
# aligned. Getting this wrong crashes inside Windows, not in the program.
umurimo push_tmp(g: Gen, r: umubare) { push(g.k, r); g.stackSlots = g.stackSlots + 1; }
umurimo pop_tmp(g: Gen, r: umubare)  { pop(g.k, r);  g.stackSlots = g.stackSlots - 1; }
umurimo call_pad(g: Gen): umubare {
  niba (biti_na(g.stackSlots, 1)) { tanga 8; }
  tanga 0;
}

umurimo call_runtime(g: Gen, izina: ijambo) {
  reka pad = call_pad(g);
  sub_imm(g.k, 4, 32 + pad);
  call_label(g.k, izina);
  add_imm(g.k, 4, 32 + pad);
}

umurimo ni_ijambo(g: Gen, izina: ijambo): umubare {
  niba (arimo(g.fn.ubwoko_bwa, izina)) { tanga fata(g.fn.ubwoko_bwa, izina); }
  tanga 0;
}

# ---- ubwoko -- the little type inference this subset needs ----------------
#  Only Int and Str, and only where it is certain. It has to agree with the
#  C++ inference on every program in the corpus or the bytes differ.
umurimo ubwoko_bw_imvugo(g: Gen, n: Igice): umubare {
  reka t = n.ubwoko_bwacyo;
  niba (t == "Str") { tanga 1; }
  niba (t == "Var") { tanga ni_ijambo(g, n.sval); }
  niba (t == "Call") {
    niba (arimo(g.fn_str, n.sval)) { tanga fata(g.fn_str, n.sval); }
    tanga 0;
  }
  niba (t == "Bin") {
    niba (n.sval == "&&" cyangwa n.sval == "||") { tanga 0; }
    niba (n.sval == "<" cyangwa n.sval == ">" cyangwa n.sval == "<=" cyangwa
          n.sval == ">=" cyangwa n.sval == "==" cyangwa n.sval == "!=") { tanga 0; }
    reka ab: urutonde<Igice> = n.abana;
    niba (n.sval == "+" na ubwoko_bw_imvugo(g, ab[0]) na ubwoko_bw_imvugo(g, ab[1])) {
      tanga 1;
    }
    tanga 0;
  }
  niba (t == "Assign") {
    reka ab: urutonde<Igice> = n.abana;
    tanga ubwoko_bw_imvugo(g, ab[0]);
  }
  tanga 0;
}

# ---- amagambo -- string literals ------------------------------------------
umurimo ongeraho_ijambo(g: Gen, v: ijambo): ijambo {
  reka lbl = "str_" + mu_ijambo(ubunini(g.amagambo));
  g.amagambo = ongeraho(g.amagambo, v);
  tanga lbl;
}

# ---- gutegura -- frame layout ---------------------------------------------
#  Exactly buildFnInfo: parameters first, then every `reka` in the body, each
#  8 bytes, then the whole thing rounded up to 16.
umurimo tora_amazina(n: Igice, out: urutonde): urutonde {
  niba (n.ubwoko_bwacyo == "VarDecl") { out = ongeraho(out, n.sval); }
  niba (n.ubwoko_bwacyo == "FuncDecl") { tanga out; }
  niba (n.ubwoko_bwacyo == "Lambda") { tanga out; }
  reka ab: urutonde<Igice> = n.abana;
  reka i = 0;
  mugihe (i < ubunini(ab)) { out = tora_amazina(ab[i], out); i = i + 1; }
  tanga out;
}

umurimo tegura_fn(g: Gen, params: urutonde, body: Igice): Fn {
  reka f: Fn = Fn(inkoranya(), inkoranya(), 0, "");
  reka off = 8;
  reka ps: urutonde<ijambo> = params;
  reka i = 0;
  mugihe (i < ubunini(ps)) {
    f.izina = shyiramo(f.izina, ps[i], off);
    off = off + 8;
    i = i + 1;
  }
  reka locals: urutonde<ijambo> = tora_amazina(body, urutonde(0));
  i = 0;
  mugihe (i < ubunini(locals)) {
    niba (arimo(f.izina, locals[i]) == 0) {
      f.izina = shyiramo(f.izina, locals[i], off);
      off = off + 8;
    }
    i = i + 1;
  }
  reka size = off - 8;
  f.frameSize = biti_na(size + 15, 0 - 16);
  tanga f;
}

umurimo aho_ry_ikigereranyo(g: Gen, izina: ijambo): umubare {
  niba (arimo(g.fn.izina, izina) == 0) {
    reka_ikosa(g, "ikigereranyo kitazwi: " + izina);
    tanga 8;
  }
  tanga fata(g.fn.izina, izina);
}

# ---- gusohora -- which locals this frame may free -------------------------
#  Mirrors the escape analysis in src/codegen.cpp. A local is freed only when
#  every value it held was a FRESH allocation and the value never left the
#  variable. In this subset the only fresh allocation is a string
#  concatenation, so the rule is small -- but it has to agree exactly, or the
#  prologue that zeroes those slots differs and so does every byte after it.
umurimo ni_gishya(g: Gen, n: Igice): umubare {
  niba (n.ubwoko_bwacyo == "Bin" na n.sval == "+" na ubwoko_bw_imvugo(g, n)) { tanga 1; }
  tanga 0;
}

# Every name mentioned anywhere below n, for subtrees that are wholly unsafe.
umurimo amazina_yose(n: Igice, out: urutonde): urutonde {
  reka t = n.ubwoko_bwacyo;
  niba (t == "Var" cyangwa t == "Assign" cyangwa t == "Call") {
    out = ongeraho(out, n.sval);
  }
  reka ab: urutonde<Igice> = n.abana;
  reka i = 0;
  mugihe (i < ubunini(ab)) { out = amazina_yose(ab[i], out); i = i + 1; }
  tanga out;
}

umurimo tora_gusohoka(n: Igice, bad: urutonde): urutonde {
  reka t = n.ubwoko_bwacyo;
  reka ab: urutonde<Igice> = n.abana;

  niba (t == "VarDecl" cyangwa t == "Assign") {
    # `reka x = v;` and `x = v;` make a second name for the same block.
    niba (ubunini(ab) > 0) {
      niba (ab[0].ubwoko_bwacyo == "Var") { bad = ongeraho(bad, ab[0].sval); }
      bad = tora_gusohoka(ab[0], bad);
    }
    tanga bad;
  }
  niba (t == "Return") {
    reka i = 0;
    mugihe (i < ubunini(ab)) { bad = amazina_yose(ab[i], bad); i = i + 1; }
    tanga bad;
  }
  niba (t == "Call") {
    # Every call in this subset is a user function, and this walk is not
    # looking at its body, so assume it keeps what it is given.
    reka i = 0;
    mugihe (i < ubunini(ab)) { bad = amazina_yose(ab[i], bad); i = i + 1; }
    tanga bad;
  }
  niba (t == "FuncDecl" cyangwa t == "Lambda") { tanga bad; }

  reka i = 0;
  mugihe (i < ubunini(ab)) { bad = tora_gusohoka(ab[i], bad); i = i + 1; }
  tanga bad;
}

# A name is freeable only if EVERY value assigned to it is a fresh allocation.
umurimo tora_gushyirwaho(g: Gen, n: Igice, izina: urutonde, ok: urutonde): urutonde {
  reka t = n.ubwoko_bwacyo;
  niba (t == "FuncDecl" cyangwa t == "Lambda") { tanga ok; }
  reka ab: urutonde<Igice> = n.abana;
  niba ((t == "VarDecl" cyangwa t == "Assign") na ubunini(ab) > 0) {
    reka fresh = ni_gishya(g, ab[0]);
    niba (arimo(ok, n.sval)) {
      niba (fresh == 0) { ok = shyiramo(ok, n.sval, 0); }
    }
    ubundi {
      ok = shyiramo(ok, n.sval, fresh);
    }
  }
  reka i = 0;
  mugihe (i < ubunini(ab)) { ok = tora_gushyirwaho(g, ab[i], izina, ok); i = i + 1; }
  tanga ok;
}

umurimo urimo_ijambo(v: urutonde, s: ijambo): umubare {
  reka bose: urutonde<ijambo> = v;
  reka i = 0;
  mugihe (i < ubunini(bose)) {
    niba (bose[i] == s) { tanga 1; }
    i = i + 1;
  }
  tanga 0;
}

# The C++ side keeps these in a std::set, which iterates in sorted order, and
# the prologue and epilogue emit one instruction per entry -- so the order is
# part of the output and has to match.
umurimo shira_ku_murongo(v: urutonde): urutonde {
  reka bose: urutonde<ijambo> = v;
  reka i = 1;
  mugihe (i < ubunini(bose)) {
    reka cur = bose[i];
    reka j = i - 1;
    mugihe (j >= 0) {
      niba (bose[j] > cur) { bose[j + 1] = bose[j]; j = j - 1; }
      ubundi { hagarika; }
    }
    bose[j + 1] = cur;
    i = i + 1;
  }
  tanga bose;
}

umurimo tora_isohoka(g: Gen, params: urutonde, body: Igice): urutonde {
  reka bad: urutonde<ijambo> = tora_gusohoka(body, urutonde(0));
  reka fresh = tora_gushyirwaho(g, body, urutonde(0), inkoranya());
  reka locals: urutonde<ijambo> = tora_amazina(body, urutonde(0));
  reka ps: urutonde<ijambo> = params;
  reka out: urutonde<ijambo> = urutonde(0);
  reka i = 0;
  mugihe (i < ubunini(locals)) {
    reka l = locals[i];
    niba (urimo_ijambo(bad, l) == 0 na urimo_ijambo(ps, l) == 0 na
          arimo(fresh, l) na fata(fresh, l) na urimo_ijambo(out, l) == 0) {
      out = ongeraho(out, l);
    }
    i = i + 1;
  }
  tanga shira_ku_murongo(out);
}

# ---- guhamagara -- calls ---------------------------------------------------
#  Win64 gives argument i its home at [rsp + 8*i] in the outgoing area -- the
#  32-byte shadow space IS the home for the first four. One reservation covers
#  the lot: store each argument as it is evaluated, then load the first four
#  into RCX/RDX/R8/R9. That keeps left-to-right evaluation order and keeps RSP
#  aligned throughout.
umurimo emit_call(g: Gen, target: ijambo, args: urutonde) {
  reka ab: urutonde<Igice> = args;
  reka n = ubunini(ab);
  reka homeSlots = 4;
  niba (n > 4) { homeSlots = n; }
  reka pad = 0;
  niba (biti_na(homeSlots + g.stackSlots, 1)) { pad = 8; }
  reka reserve = homeSlots * 8 + pad;

  sub_imm(g.k, 4, reserve);
  reka saved = g.stackSlots;
  g.stackSlots = 0;

  reka i = 0;
  mugihe (i < n) {
    gen_imvugo(g, ab[i]);
    mov_store_base(g.k, 4, i * 8, 0);
    i = i + 1;
  }
  i = 0;
  mugihe (i < n na i < 4) {
    mov_load_base(g.k, arg_reg(i), 4, i * 8);
    i = i + 1;
  }
  call_label(g.k, target);
  g.stackSlots = saved;
  add_imm(g.k, 4, reserve);
}

# Store into a local, first releasing whatever the slot held when this frame
# owns it. The new value is computed BEFORE the old one is freed, because the
# new one is often built out of the old: `s = s + "x"`.
umurimo shyira_mu_kigereranyo(g: Gen, n: Igice) {
  reka ab: urutonde<Igice> = n.abana;
  gen_imvugo(g, ab[0]);
  reka slot = 0 - aho_ry_ikigereranyo(g, n.sval);
  niba (urimo_ijambo(g.isohoka, n.sval)) {
    push_tmp(g, 0);
    mov_load_rbp(g.k, 1, slot);
    call_runtime(g, "wandaa_free");
    pop_tmp(g, 0);
  }
  mov_store_rbp(g.k, slot, 0);
}

# ---- imvugo -- expressions -------------------------------------------------
umurimo gen_imvugo(g: Gen, n: Igice) {
  reka t = n.ubwoko_bwacyo;
  reka ab: urutonde<Igice> = n.abana;

  niba (t == "Num") {
    niba (n.ni_ibice) { reka_ikosa(g, "imibare y'ibice ntiyemewe muri iyi verisiyo"); tanga 0; }
    mov_imm(g.k, 0, mu_mubare(n.sval));
  }
  ubundi niba (t == "Str") {
    lea_rip(g.k, 0, ongeraho_ijambo(g, n.sval));
  }
  ubundi niba (t == "Bool") {
    mov_imm(g.k, 0, n.bval);
  }
  ubundi niba (t == "Var") {
    mov_load_rbp(g.k, 0, 0 - aho_ry_ikigereranyo(g, n.sval));
  }
  ubundi niba (t == "Un") {
    gen_imvugo(g, ab[0]);
    niba (n.sval == "!") {
      test(g.k, 0, 0);
      setcc(g.k, "e");
      movzx_rax_al(g.k);
    }
    ubundi {
      mov_reg(g.k, 3, 0);
      mov_imm(g.k, 0, 0);
      sub(g.k, 0, 3);
    }
  }
  ubundi niba (t == "Call") {
    emit_call(g, n.sval, n.abana);
  }
  ubundi niba (t == "Bin") {
    gen_bin(g, n);
  }
  ubundi niba (t == "Assign") {
    # An assignment is an expression: `i = i + 1;` parses as an ExprStmt
    # holding one, and the value stays in RAX afterwards.
    shyira_mu_kigereranyo(g, n);
  }
  ubundi {
    reka_ikosa(g, "iyi mvugo ntiyemewe muri iyi verisiyo: " + t);
  }
}

umurimo gen_bin(g: Gen, n: Igice) {
  reka ab: urutonde<Igice> = n.abana;
  reka op = n.sval;

  # Short-circuit: the right side must not run when the left already decides.
  niba (op == "&&" cyangwa op == "||") {
    reka isAnd = 0;
    niba (op == "&&") { isAnd = 1; }
    reka Lshort = "";
    niba (isAnd) { Lshort = izina_rishya(g, "Land_false_"); }
    ubundi { Lshort = izina_rishya(g, "Lor_true_"); }
    reka Lend = izina_rishya(g, "Lbool_end_");

    gen_imvugo(g, ab[0]);
    test(g.k, 0, 0);
    niba (isAnd) { jz(g.k, Lshort); } ubundi { jnz(g.k, Lshort); }

    gen_imvugo(g, ab[1]);
    test(g.k, 0, 0);
    niba (isAnd) { jz(g.k, Lshort); } ubundi { jnz(g.k, Lshort); }

    niba (isAnd) { mov_imm(g.k, 0, 1); } ubundi { mov_imm(g.k, 0, 0); }
    jmp(g.k, Lend);
    shyiraho_izina(g.k, Lshort);
    niba (isAnd) { mov_imm(g.k, 0, 0); } ubundi { mov_imm(g.k, 0, 1); }
    shyiraho_izina(g.k, Lend);
    tanga 0;
  }

  reka bothStr = ubwoko_bw_imvugo(g, ab[0]) na ubwoko_bw_imvugo(g, ab[1]);

  niba (op == "+" na bothStr) {
    gen_imvugo(g, ab[0]);
    push_tmp(g, 0);
    gen_imvugo(g, ab[1]);
    mov_reg(g.k, 2, 0);
    pop_tmp(g, 1);
    call_runtime(g, "wandaa_str_concat");
    tanga 0;
  }
  niba ((op == "==" cyangwa op == "!=") na bothStr) {
    gen_imvugo(g, ab[0]);
    push_tmp(g, 0);
    gen_imvugo(g, ab[1]);
    mov_reg(g.k, 2, 0);
    pop_tmp(g, 1);
    call_runtime(g, "wandaa_str_eq");
    niba (op == "!=") { xor_imm(g.k, 0, 1); }
    tanga 0;
  }

  # ---- the integer path ----
  gen_imvugo(g, ab[0]);
  push_tmp(g, 0);
  gen_imvugo(g, ab[1]);
  mov_reg(g.k, 3, 0);
  pop_tmp(g, 0);

  niba (op == "+") { add(g.k, 0, 3); }
  ubundi niba (op == "-") { sub(g.k, 0, 3); }
  ubundi niba (op == "*") { imul(g.k, 0, 3); }
  ubundi niba (op == "/") { cqo(g.k); idiv(g.k, 3); }
  ubundi {
    cmp(g.k, 0, 3);
    reka cc = "ne";
    niba (op == "<") { cc = "l"; }
    ubundi niba (op == ">") { cc = "g"; }
    ubundi niba (op == "<=") { cc = "le"; }
    ubundi niba (op == ">=") { cc = "ge"; }
    ubundi niba (op == "==") { cc = "e"; }
    setcc(g.k, cc);
    movzx_rax_al(g.k);
  }
}

# ---- amabwiriza -- statements ---------------------------------------------
umurimo gen_ibwiriza(g: Gen, n: Igice) {
  # Line tracking for the crash handler. wandaa_current_line is an 8-byte slot
  # inside the runtime blob's data region, reached RIP-relatively.
  niba (n.umurongo > 0) { mov_store_imm_rip(g.k, "wandaa_current_line", n.umurongo); }

  reka t = n.ubwoko_bwacyo;
  reka ab: urutonde<Igice> = n.abana;

  niba (t == "VarDecl" cyangwa t == "Assign") {
    shyira_mu_kigereranyo(g, n);
  }
  ubundi niba (t == "ExprStmt") {
    gen_imvugo(g, ab[0]);
  }
  ubundi niba (t == "Print") {
    reka i = 0;
    mugihe (i < ubunini(ab)) {
      reka ni_riro = ubwoko_bw_imvugo(g, ab[i]);
      gen_imvugo(g, ab[i]);
      mov_reg(g.k, 1, 0);
      niba (ni_riro) { call_runtime(g, "wandaa_print_strval"); }
      ubundi { call_runtime(g, "wandaa_print_int"); }
      i = i + 1;
    }
  }
  ubundi niba (t == "If") {
    reka Lelse = izina_rishya(g, "Lelse_");
    reka Lend = izina_rishya(g, "Lend_");
    gen_imvugo(g, ab[0]);
    test(g.k, 0, 0);
    jz(g.k, Lelse);
    gen_ibwiriza(g, ab[1]);
    jmp(g.k, Lend);
    shyiraho_izina(g.k, Lelse);
    niba (ubunini(ab) > 2) { gen_ibwiriza(g, ab[2]); }
    shyiraho_izina(g.k, Lend);
  }
  ubundi niba (t == "While") {
    reka Lstart = izina_rishya(g, "Lstart_");
    reka Lend = izina_rishya(g, "Lend_");
    shyiraho_izina(g.k, Lstart);
    gen_imvugo(g, ab[0]);
    test(g.k, 0, 0);
    jz(g.k, Lend);
    g.loop_end = ongeraho(g.loop_end, Lend);
    g.loop_top = ongeraho(g.loop_top, Lstart);
    gen_ibwiriza(g, ab[1]);
    g.loop_end[ubunini(g.loop_end) - 1] = "";      # pop, by emptying the slot
    g.loop_top[ubunini(g.loop_top) - 1] = "";
    jmp(g.k, Lstart);
    shyiraho_izina(g.k, Lend);
  }
  ubundi niba (t == "Break" cyangwa t == "Continue") {
    # Find the innermost loop still open.
    reka bose: urutonde<ijambo> = g.loop_end;
    reka hejuru_yo: urutonde<ijambo> = g.loop_top;
    reka i = ubunini(bose) - 1;
    mugihe (i >= 0) {
      niba (uburebure(bose[i]) > 0) {
        niba (t == "Break") { jmp(g.k, bose[i]); }
        ubundi { jmp(g.k, hejuru_yo[i]); }
        tanga 0;
      }
      i = i - 1;
    }
    niba (t == "Break") { reka_ikosa(g, "'hagarika' iri hanze ya 'mugihe'"); }
    ubundi { reka_ikosa(g, "'komeza' iri hanze ya 'mugihe'"); }
  }
  ubundi niba (t == "Block") {
    reka i = 0;
    mugihe (i < ubunini(ab)) { gen_ibwiriza(g, ab[i]); i = i + 1; }
  }
  ubundi niba (t == "Return") {
    niba (ubunini(ab) > 0) { gen_imvugo(g, ab[0]); }
    ubundi { xor_eax_eax(g.k); }
    jmp(g.k, g.fn.epilogue);
  }
  ubundi niba (t == "FuncDecl") {
    tanga 0;                                       # declaration only
  }
  ubundi {
    reka_ikosa(g, "iri bwiriza ntiryemewe muri iyi verisiyo: " + t);
  }
}

# ---- umurimo -- one function ----------------------------------------------
umurimo gen_umurimo(g: Gen, izina: ijambo, params: urutonde, body: Igice,
                    paramTypes: urutonde) {
  g.fn = tegura_fn(g, params, body);
  g.fn.epilogue = izina + "_epilogue";

  # Which locals hold strings, so `andika` and `+` pick the right path.
  reka ps: urutonde<ijambo> = params;
  reka pt: urutonde<ijambo> = paramTypes;
  reka i = 0;
  mugihe (i < ubunini(ps)) {
    reka ni_riro = 0;
    niba (i < ubunini(pt) na pt[i] == "ijambo") { ni_riro = 1; }
    g.fn.ubwoko_bwa = shyiramo(g.fn.ubwoko_bwa, ps[i], ni_riro);
    i = i + 1;
  }
  tora_ubwoko(g, body);
  g.isohoka = tora_isohoka(g, params, body);

  shyiraho_izina(g.k, izina);

  # push rbp is part of the frame, not a temporary: RSP is 16-byte aligned
  # again once the frame is subtracted, so the counter resets here.
  push(g.k, 5);
  mov_reg(g.k, 5, 4);
  g.stackSlots = 0;
  niba (g.fn.frameSize > 0) { sub_imm(g.k, 4, g.fn.frameSize); }

  # Spill the incoming arguments into their frame slots.
  i = 0;
  mugihe (i < ubunini(ps)) {
    reka slot = 0 - fata(g.fn.izina, ps[i]);
    niba (i < 4) {
      mov_store_rbp(g.k, slot, arg_reg(i));
    }
    ubundi {
      mov_load_rbp(g.k, 0, 16 + 8 * i);
      mov_store_rbp(g.k, slot, 0);
    }
    i = i + 1;
  }

  # Zero every slot that will be freed: a `reka` inside a branch that never
  # runs would otherwise leave garbage for the epilogue to hand HeapFree.
  reka iso: urutonde<ijambo> = g.isohoka;
  niba (ubunini(iso) > 0) {
    xor_eax_eax(g.k);
    i = 0;
    mugihe (i < ubunini(iso)) {
      mov_store_rbp(g.k, 0 - fata(g.fn.izina, iso[i]), 0);
      i = i + 1;
    }
  }

  gen_ibwiriza(g, body);

  xor_eax_eax(g.k);
  shyiraho_izina(g.k, g.fn.epilogue);

  # Free what this frame owns. The return value is already in RAX and
  # wandaa_free clobbers it, so it is saved across them.
  niba (ubunini(iso) > 0) {
    reka saved = g.stackSlots;
    g.stackSlots = 0;
    push_tmp(g, 0);
    i = 0;
    mugihe (i < ubunini(iso)) {
      mov_load_rbp(g.k, 1, 0 - fata(g.fn.izina, iso[i]));
      call_runtime(g, "wandaa_free");
      i = i + 1;
    }
    pop_tmp(g, 0);
    g.stackSlots = saved;
  }
  # Restore RSP from RBP rather than adding the frame size back: a jump here
  # from the middle of an expression may have left more on the stack.
  mov_reg(g.k, 4, 5);
  pop(g.k, 5);
  ret(g.k);
}

# Walk a body recording which locals hold strings. Mirrors the Str half of
# the C++ inference, which is all this subset needs.
umurimo tora_ubwoko(g: Gen, n: Igice) {
  niba (n.ubwoko_bwacyo == "FuncDecl" cyangwa n.ubwoko_bwacyo == "Lambda") { tanga 0; }
  reka ab: urutonde<Igice> = n.abana;
  niba (n.ubwoko_bwacyo == "VarDecl" cyangwa n.ubwoko_bwacyo == "Assign") {
    niba (ubunini(ab) > 0) {
      reka ni_riro = ubwoko_bw_imvugo(g, ab[0]);
      niba (n.retType == "ijambo") { ni_riro = 1; }
      niba (ni_riro) { g.fn.ubwoko_bwa = shyiramo(g.fn.ubwoko_bwa, n.sval, 1); }
    }
  }
  reka i = 0;
  mugihe (i < ubunini(ab)) { tora_ubwoko(g, ab[i]); i = i + 1; }
}

# ---- ahantu h'amagambo -- the string literal data area ---------------------
#  Each literal is 8-aligned and carries a capacity word of -1 marking it
#  STATIC, then its length, then the bytes and a NUL. The -1 is what stops
#  wandaa_free ever handing a literal to HeapFree.
umurimo ubaka_amagambo(g: Gen, dataBase: umubare): urutonde {
  reka data = urutonde(0);
  reka bose: urutonde<ijambo> = g.amagambo;
  reka i = 0;
  mugihe (i < ubunini(bose)) {
    mugihe (biti_na(dataBase + ubunini(data), 7) != 0) { data = ongeraho(data, 0); }
    reka s = bose[i];
    reka b = 0;
    mugihe (b < 8) { data = ongeraho(data, 255); b = b + 1; }          # capacity -1
    reka len = uburebure(s);
    b = 0;
    mugihe (b < 8) { data = ongeraho(data, biti_na(biti_iburyo(len, b * 8), 255)); b = b + 1; }
    shyiraho_izina_hanze(g.k, "str_" + mu_ijambo(i), dataBase + ubunini(data));
    reka j = 0;
    mugihe (j < len) { data = ongeraho(data, inyuguti(s, j)); j = j + 1; }
    data = ongeraho(data, 0);
    i = i + 1;
  }
  tanga data;
}

# ---- kubaka -- build the executable ---------------------------------------
umurimo ubaka(g: Gen, program: Igice, b: Blob): urutonde {
  reka kids: urutonde<Igice> = program.abana;

  # Split declarations from the statements that become wandaa_main, as the
  # C++ compiler does.
  reka funcs: urutonde<Igice> = urutonde(0);
  reka rest: Igice = igice_gishya("Block");
  reka i = 0;
  mugihe (i < ubunini(kids)) {
    reka t = kids[i].ubwoko_bwacyo;
    niba (t == "FuncDecl") { funcs = ongeraho(funcs, kids[i]); }
    ubundi niba (t == "ExternDecl" cyangwa t == "RecordDecl") {
      reka_ikosa(g, "'" + t + "' ntiryemewe muri iyi verisiyo");
    }
    ubundi { ongeraho_umwana(rest, kids[i]); }
    i = i + 1;
  }

  # A function returning a string, so a call to it types as one.
  i = 0;
  mugihe (i < ubunini(funcs)) {
    niba (funcs[i].retType == "ijambo") { g.fn_str = shyiramo(g.fn_str, funcs[i].sval, 1); }
    i = i + 1;
  }

  # --- 1. imports: everything the runtime blob calls, plus the two the
  # generated code calls directly for array literals.
  reka imp_dll: urutonde<ijambo> = b.imp_dll;
  reka imp_func: urutonde<ijambo> = b.imp_func;
  reka seen = inkoranya();
  reka ids = inkoranya();
  i = 0;
  mugihe (i < ubunini(imp_dll)) {
    reka key = imp_dll[i] + "!" + imp_func[i];
    niba (arimo(seen, key) == 0) {
      seen = shyiramo(seen, key, 1);
      ids = shyiramo(ids, key, pe_ongeraho_import(g.p, imp_dll[i], imp_func[i]));
    }
    i = i + 1;
  }
  reka extra: urutonde<ijambo> = ["GetProcessHeap", "HeapAlloc"];
  i = 0;
  mugihe (i < ubunini(extra)) {
    reka key = "kernel32.dll!" + extra[i];
    niba (arimo(seen, key) == 0) {
      seen = shyiramo(seen, key, 1);
      ids = shyiramo(ids, key, pe_ongeraho_import(g.p, "kernel32.dll", extra[i]));
    }
    i = i + 1;
  }

  # --- 2. section layout. The import block leaves the cursor anywhere, so the
  # blob is padded up to 16 for the .p2align directives inside runtime.s to
  # still mean something once it is relocated.
  reka rawBase = pe_begin_code(g.p);
  reka blobPad = biti_na(16 - biti_na(rawBase, 15), 15);
  reka blobBase = rawBase + blobPad;
  reka codeBase = blobBase + ubunini(b.bayiti);
  kode_base(g.k, codeBase);

  # Runtime entry points and data slots become ordinary labels.
  reka lbls: urutonde<ijambo> = b.label_izina;
  i = 0;
  mugihe (i < ubunini(lbls)) {
    shyiraho_izina_hanze(g.k, lbls[i], blobBase + fata(b.label_aho, lbls[i]));
    i = i + 1;
  }
  # IAT slots likewise, so generated code can `call [rip+__imp_X]`.
  i = 0;
  mugihe (i < ubunini(imp_dll)) {
    reka key = imp_dll[i] + "!" + imp_func[i];
    shyiraho_izina_hanze(g.k, "__imp_" + imp_func[i], pe_iat(g.p, fata(ids, key)));
    i = i + 1;
  }
  i = 0;
  mugihe (i < ubunini(extra)) {
    reka key = "kernel32.dll!" + extra[i];
    shyiraho_izina_hanze(g.k, "__imp_" + extra[i], pe_iat(g.p, fata(ids, key)));
    i = i + 1;
  }

  # --- 3. the generated code
  i = 0;
  mugihe (i < ubunini(funcs)) {
    reka f: Igice = funcs[i];
    gen_umurimo(g, f.sval, f.params, f.abana[0], f.paramTypes);
    i = i + 1;
  }
  reka mainOffset = codeBase + ubunini(g.k.bayiti);
  gen_umurimo(g, "wandaa_main", urutonde(0), rest, urutonde(0));

  # --- 4. string data, then resolve every fixup
  reka dataBase = codeBase + ubunini(g.k.bayiti);
  dataBase = biti_na(dataBase + 7, 0 - 8);
  reka codePad = dataBase - (codeBase + ubunini(g.k.bayiti));
  reka data = ubaka_amagambo(g, dataBase);

  reka err = kemura_fixups(g.k);
  niba (uburebure(err) > 0) { reka_ikosa(g, err); tanga urutonde(0); }

  # --- 5. patch the runtime blob. Each `call [rip+__imp_X]` in it was
  # assembled against a placeholder; repoint it at the real IAT slot.
  reka blob = b.bayiti;
  i = 0;
  mugihe (i < ubunini(imp_dll)) {
    reka key = imp_dll[i] + "!" + imp_func[i];
    reka slot = pe_iat(g.p, fata(ids, key));
    reka site = blobBase + b.imp_site[i];
    reka v = slot + b.imp_addend[i] - (site + 4);
    reka j = 0;
    mugihe (j < 4) { blob[b.imp_site[i] + j] = biti_na(biti_iburyo(v, j * 8), 255); j = j + 1; }
    i = i + 1;
  }
  # The single blob -> generated-code edge: _start's `call wandaa_main`.
  reka csym: urutonde<ijambo> = b.code_sym;
  i = 0;
  mugihe (i < ubunini(csym)) {
    niba (csym[i] != "wandaa_main") {
      reka_ikosa(g, "runtime blob references an unknown symbol: " + csym[i]);
      tanga urutonde(0);
    }
    reka site = blobBase + b.code_site[i];
    reka v = mainOffset + b.code_addend[i] - (site + 4);
    reka j = 0;
    mugihe (j < 4) { blob[b.code_site[i] + j] = biti_na(biti_iburyo(v, j * 8), 255); j = j + 1; }
    i = i + 1;
  }

  # --- 6. assemble the image
  i = 0;
  mugihe (i < blobPad) { pe_byte(g.p, 0); i = i + 1; }
  i = 0;
  mugihe (i < ubunini(blob)) { pe_byte(g.p, blob[i]); i = i + 1; }
  i = 0;
  mugihe (i < ubunini(g.k.bayiti)) { pe_byte(g.p, g.k.bayiti[i]); i = i + 1; }
  i = 0;
  mugihe (i < codePad) { pe_byte(g.p, 0); i = i + 1; }
  i = 0;
  mugihe (i < ubunini(data)) { pe_byte(g.p, data[i]); i = i + 1; }
  pe_entry(g.p, blobBase + fata(b.label_aho, "_start"));

  tanga pe_image(g.p);
}

# ---- gutangira -- the driver ----------------------------------------------
#  Two paths are taken from the command line: the source and the output. The
#  path helper in ibimenyetso.waa returns only the last argument, so this
#  reads both fields itself.
ubwoko Amab { s: ijambo, i: umubare, n: umubare }

umurimo amab_field(c: Amab): ijambo {
  mugihe (c.i < c.n na inyuguti(c.s, c.i) == 32) { c.i = c.i + 1; }
  niba (c.i >= c.n) { tanga ""; }
  reka aho = c.i;
  mugihe (c.i < c.n na inyuguti(c.s, c.i) != 32) { c.i = c.i + 1; }
  reka f = igice(c.s, aho, c.i - aho);
  niba (uburebure(f) >= 2 na inyuguti(f, 0) == 34) {
    f = igice(f, 1, uburebure(f) - 2);
  }
  tanga f;
}

reka cmd: ijambo = ijambo(GetCommandLineA());
reka c: Amab = Amab(cmd, 0, uburebure(cmd));
reka argv0: ijambo = amab_field(c);           # the executable itself
reka inzira: ijambo = amab_field(c);
reka ahasohokera: ijambo = amab_field(c);

niba (uburebure(inzira) == 0 cyangwa uburebure(ahasohokera) == 0) {
  andika("gukoresha: codegen <dosiye.waa> <out.exe>");
}
ubundi {
  reka amasoko: ijambo = soma(inzira);
  niba (uburebure(amasoko) == 0) {
    andika("Ikosa: ntibashoboye gusoma " + inzira);
  }
  ubundi {
    reka r = sesengura(amasoko);
    niba (byarakunze(r) == 0) {
      andika("Ikosa ryo gukusanya: " + ikosa(r));
    }
    ubundi {
      reka toks: urutonde<Ikimenyetso> = agaciro(r);
      reka igiti: Igice = sesengura_porogaramu(toks);
      niba (igiti.ubwoko_bwacyo == "IKOSA") {
        andika("Ikosa ryo gukusanya: " + igiti.sval);
      }
      ubundi {
        reka b: Blob = soma_blob("include/runtime_blob.txt");
        niba (ubunini(b.bayiti) == 0) {
          andika("Ikosa: ntibashoboye gusoma include/runtime_blob.txt");
        }
        ubundi {
          reka g: Gen = gen_nshya();
          reka img = ubaka(g, igiti, b);
          niba (uburebure(g.ikosa) > 0) {
            andika("Ikosa ryo gukusanya: " + g.ikosa);
          }
          ubundi {
            reka ok = andikamo(ahasohokera, mu_bayiti(img));
            niba (ok == 0) { andika("Ikosa: ntibashoboye kwandika " + ahasohokera); }
          }
        }
      }
    }
  }
}
