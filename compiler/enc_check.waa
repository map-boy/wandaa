# ===========================================================================
#  compiler/enc_check.waa -- run the Wandaa encoder over the shared cases.
#
#  Reads the script tools/enc/enc_script.cpp wrote, encodes each case with
#  compiler/x64.waa, and prints the bytes as hex -- one line per case, lining
#  up with the expect.hex the same tool wrote. compiler/verify_enc.sh diffs
#  the two.
#
#      waa compiler/enc_check.waa <script.txt>
# ===========================================================================

injiza "x64.waa";
injiza "ibimenyetso.waa";          # for inzira_yatanzwe()

# A cursor over the script text.
ubwoko Soma { s: ijambo, i: umubare, n: umubare }

umurimo ni_umwanya_cg_umurongo(c: umubare): umubare {
  tanga c == 32 cyangwa c == 9 cyangwa c == 13;
}

# The next space-separated field on this line, or "" at end of line.
umurimo igice_gikurikira(c: Soma): ijambo {
  mugihe (c.i < c.n na ni_umwanya_cg_umurongo(inyuguti(c.s, c.i))) { c.i = c.i + 1; }
  niba (c.i >= c.n) { tanga ""; }
  niba (inyuguti(c.s, c.i) == 10) { tanga ""; }
  reka aho = c.i;
  mugihe (c.i < c.n) {
    reka d = inyuguti(c.s, c.i);
    niba (d == 32 cyangwa d == 10 cyangwa d == 13 cyangwa d == 9) { hagarika; }
    c.i = c.i + 1;
  }
  tanga igice(c.s, aho, c.i - aho);
}

umurimo simbuka_umurongo(c: Soma) {
  mugihe (c.i < c.n na inyuguti(c.s, c.i) != 10) { c.i = c.i + 1; }
  niba (c.i < c.n) { c.i = c.i + 1; }
}

umurimo umubare_gikurikira(c: Soma): umubare {
  tanga mu_mubare(igice_gikurikira(c));
}

umurimo hex1(v: umubare): ijambo {
  tanga igice("0123456789abcdef", biti_na(v, 15), 1);
}
umurimo hex2(b: umubare): ijambo {
  tanga hex1(biti_iburyo(b, 4)) + hex1(b);
}

umurimo hex_yose(k: Kode): ijambo {
  reka o = "";
  reka i = 0;
  mugihe (i < ubunini(k.bayiti)) {
    o = o + hex2(k.bayiti[i]);
    i = i + 1;
  }
  tanga o;
}

reka inzira: ijambo = inzira_yatanzwe();
reka amasoko: ijambo = soma(inzira);

niba (uburebure(amasoko) == 0) {
  andika("Ikosa: ntibashoboye gusoma " + inzira);
}
ubundi {
  reka c: Soma = Soma(amasoko, 0, uburebure(amasoko));

  mugihe (c.i < c.n) {
    reka izina: ijambo = igice_gikurikira(c);
    niba (uburebure(izina) == 0) { simbuka_umurongo(c); komeza; }

    reka k: Kode = kode_nshya();

    # ---- reg, reg ----
    niba (izina == "mov_reg") { reka d = umubare_gikurikira(c); mov_reg(k, d, umubare_gikurikira(c)); }
    ubundi niba (izina == "add") { reka d = umubare_gikurikira(c); add(k, d, umubare_gikurikira(c)); }
    ubundi niba (izina == "sub") { reka d = umubare_gikurikira(c); sub(k, d, umubare_gikurikira(c)); }
    ubundi niba (izina == "cmp") { reka d = umubare_gikurikira(c); cmp(k, d, umubare_gikurikira(c)); }
    ubundi niba (izina == "xorr") { reka d = umubare_gikurikira(c); xorr(k, d, umubare_gikurikira(c)); }
    ubundi niba (izina == "andr") { reka d = umubare_gikurikira(c); andr(k, d, umubare_gikurikira(c)); }
    ubundi niba (izina == "orr") { reka d = umubare_gikurikira(c); orr(k, d, umubare_gikurikira(c)); }
    ubundi niba (izina == "test") { reka d = umubare_gikurikira(c); test(k, d, umubare_gikurikira(c)); }
    ubundi niba (izina == "imul") { reka d = umubare_gikurikira(c); imul(k, d, umubare_gikurikira(c)); }

    # ---- one register ----
    ubundi niba (izina == "push") { push(k, umubare_gikurikira(c)); }
    ubundi niba (izina == "pop") { pop(k, umubare_gikurikira(c)); }
    ubundi niba (izina == "shl_cl") { shl_cl(k, umubare_gikurikira(c)); }
    ubundi niba (izina == "shr_cl") { shr_cl(k, umubare_gikurikira(c)); }
    ubundi niba (izina == "sar_cl") { sar_cl(k, umubare_gikurikira(c)); }
    ubundi niba (izina == "idiv") { idiv(k, umubare_gikurikira(c)); }
    ubundi niba (izina == "neg") { neg(k, umubare_gikurikira(c)); }
    ubundi niba (izina == "call_reg") { call_reg(k, umubare_gikurikira(c)); }

    # ---- no operands ----
    ubundi niba (izina == "cqo") { cqo(k); }
    ubundi niba (izina == "ret") { ret(k); }
    ubundi niba (izina == "xor_eax_eax") { xor_eax_eax(k); }
    ubundi niba (izina == "movzx_rax_al") { movzx_rax_al(k); }

    # ---- immediates ----
    ubundi niba (izina == "mov_imm") { reka d = umubare_gikurikira(c); mov_imm(k, d, umubare_gikurikira(c)); }
    ubundi niba (izina == "add_imm") { reka d = umubare_gikurikira(c); add_imm(k, d, umubare_gikurikira(c)); }
    ubundi niba (izina == "sub_imm") { reka d = umubare_gikurikira(c); sub_imm(k, d, umubare_gikurikira(c)); }
    ubundi niba (izina == "xor_imm") { reka d = umubare_gikurikira(c); xor_imm(k, d, umubare_gikurikira(c)); }
    ubundi niba (izina == "cmp_imm") { reka d = umubare_gikurikira(c); cmp_imm(k, d, umubare_gikurikira(c)); }

    # ---- memory ----
    ubundi niba (izina == "mov_load_base") {
      reka d = umubare_gikurikira(c); reka b = umubare_gikurikira(c);
      mov_load_base(k, d, b, umubare_gikurikira(c));
    }
    ubundi niba (izina == "mov_store_base") {
      reka b = umubare_gikurikira(c); reka dd = umubare_gikurikira(c);
      mov_store_base(k, b, dd, umubare_gikurikira(c));
    }
    ubundi niba (izina == "lea_base") {
      reka d = umubare_gikurikira(c); reka b = umubare_gikurikira(c);
      lea_base(k, d, b, umubare_gikurikira(c));
    }
    ubundi niba (izina == "mov_store_imm_base") {
      reka b = umubare_gikurikira(c); reka dd = umubare_gikurikira(c);
      mov_store_imm_base(k, b, dd, umubare_gikurikira(c));
    }
    ubundi niba (izina == "lea_sib") {
      reka d = umubare_gikurikira(c); reka b = umubare_gikurikira(c);
      lea_sib(k, d, b, umubare_gikurikira(c));
    }
    ubundi niba (izina == "mov_load_sib") {
      reka d = umubare_gikurikira(c); reka b = umubare_gikurikira(c);
      mov_load_sib(k, d, b, umubare_gikurikira(c));
    }
    ubundi niba (izina == "lea_rbp") {
      reka d = umubare_gikurikira(c); lea_rbp(k, d, umubare_gikurikira(c));
    }
    ubundi niba (izina == "mov_store_rbp") {
      reka dd = umubare_gikurikira(c); mov_store_rbp(k, dd, umubare_gikurikira(c));
    }
    ubundi niba (izina == "mov_load_rbp") {
      reka d = umubare_gikurikira(c); mov_load_rbp(k, d, umubare_gikurikira(c));
    }
    ubundi niba (izina == "mov_store_base_byte") {
      reka b = umubare_gikurikira(c); reka dd = umubare_gikurikira(c);
      mov_store_base_byte(k, b, dd, umubare_gikurikira(c));
    }
    ubundi niba (izina == "mov_load_base_byte_zx") {
      reka d = umubare_gikurikira(c); reka b = umubare_gikurikira(c);
      mov_load_base_byte_zx(k, d, b, umubare_gikurikira(c));
    }
    ubundi niba (izina == "mov_store_base_word") {
      reka b = umubare_gikurikira(c); reka dd = umubare_gikurikira(c);
      mov_store_base_word(k, b, dd, umubare_gikurikira(c));
    }
    ubundi niba (izina == "mov_load_base_word_zx") {
      reka d = umubare_gikurikira(c); reka b = umubare_gikurikira(c);
      mov_load_base_word_zx(k, d, b, umubare_gikurikira(c));
    }
    ubundi niba (izina == "mov_store_base_dword") {
      reka b = umubare_gikurikira(c); reka dd = umubare_gikurikira(c);
      mov_store_base_dword(k, b, dd, umubare_gikurikira(c));
    }
    ubundi niba (izina == "mov_load_base_dword_zx") {
      reka d = umubare_gikurikira(c); reka b = umubare_gikurikira(c);
      mov_load_base_dword_zx(k, d, b, umubare_gikurikira(c));
    }
    ubundi niba (izina == "setcc") { setcc(k, igice_gikurikira(c)); }
    ubundi {
      andika("IKIMENYETSO KITAZWI: " + izina);
    }

    andika(hex_yose(k));
    simbuka_umurongo(c);
  }
}
