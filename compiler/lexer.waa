# ===========================================================================
#  compiler/lexer.waa -- print the token stream, for comparison with C++.
#
#  Stage 2a of the bootstrap in ROADMAP.md. The lexer itself lives in
#  compiler/ibimenyetso.waa; this is the driver that prints what it produced
#  in exactly the format `wandaac --tokens` prints, so the two streams can be
#  diffed over the whole corpus. See compiler/verify_lexer.sh.
#
#      waa compiler/lexer.waa <dosiye.waa>
# ===========================================================================

injiza "ibimenyetso.waa";

reka inzira: ijambo = inzira_yatanzwe();
reka amasoko: ijambo = soma(inzira);

niba (uburebure(amasoko) == 0) {
  andika("Ikosa: ntibashoboye gusoma " + inzira);
}
ubundi {
  reka r = sesengura(amasoko);
  niba (byarakunze(r)) {
    reka bose: urutonde<Ikimenyetso> = agaciro(r);
    reka i = 0;
    mugihe (i < ubunini(bose)) {
      reka k: Ikimenyetso = bose[i];
      andika(k.ubwoko_bwacyo + " " + mu_ijambo(k.umurongo) + " " + sohora(k.inyandiko));
      i = i + 1;
    }
  }
  ubundi {
    andika("Ikosa ryo gukusanya: " + ikosa(r));
  }
}
